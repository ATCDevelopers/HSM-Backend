# API Configuration
VITE_API_URL=http://localhost:8000/api/v1/
VITE_BASE_URL=http://localhost:8000

# Authentication
VITE_API_TOKEN_KEY=auth_token

# Environment
VITE_ENV=development

# Features/Debugging
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Optional: If using Laravel Sanctum for SPA authentication
VITE_SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Optional: WebSocket configuration (if using Laravel Broadcasting)
VITE_WEBSOCKET_URL=ws://localhost:6001
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Optional: File upload limits
VITE_MAX_FILE_SIZE=10485760

# Optional: App metadata
VITE_NAME="React Application"
VITE_VERSION=1.0.0     